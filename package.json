{
  "name": "astro",
  "version": "1.0.0",
  "description": "A personal AI agent that can help you with various tasks, such as writing code, generating content, and more.",
  "author": "Hastings Zhang",
  "docs": "www.astroagent.com",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "bin": {
    "astro": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_OPTIONS='--require ./polyfill.cjs' tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/boxen": "^3.0.5",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^17.0.93",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.4.7",
    "@langchain/tavily": "^1.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "boxen": "5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "figlet": "1.8.2",
    "ink": "3.2.0",
    "ink-text-input": "4.0.3",
    "langchain": "^1.4.4",
    "react": "17.0.2",
    "string-width": "4.2.3",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  }
